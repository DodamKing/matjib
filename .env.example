# 실제 값은 .env.local 에 두고 커밋하지 않는다 (CLAUDE.md 보안 규칙).

# 커스텀 도메인(선택). 붙이면 OG/canonical 절대경로가 이 도메인으로 고정된다.
# 미설정 시 Vercel 프로덕션 URL → localhost 순으로 자동 폴백(app/layout.tsx).
# 배포 도메인 확정: https://matjib.dimad.kr (NCP Web 서비스 URL 등록 완료, D12)
SITE_URL=

SANGWON_API_KEY=
KAKAO_REST_API_KEY=
# 네이버 클라우드 플랫폼 Static Map (장소 상세 시트 지도 미리보기, D11). 서버 전용.
# 없어도 앱은 방향·거리 로케이터로 자동 폴백됨.
NCP_MAP_CLIENT_ID=
NCP_MAP_CLIENT_SECRET=
# Dynamic Map(인터랙티브 지도, 시트 지도 탭→전체화면 핀줌) 클라이언트 키. D12 예외로 클라 노출 허용
# (지도 JS 키는 도메인 제한으로 보호되는 공개 키). 같은 Application이면 NCP_MAP_CLIENT_ID와 동일 값.
# 없으면 인터랙티브 확대 비활성(정적 지도까지만).
NEXT_PUBLIC_NCP_MAP_CLIENT_ID=

# 후원 링크(선택, D13). 「💉 개발자 카페인 수혈」 버튼이 여기로 연결된다.
# toss.me 개인 링크 또는 카카오페이 송금 링크 등 "공개 송금 링크"만. 시크릿 아님 → 클라 노출 무방.
# 예) https://toss.me/내핸들  ·  미설정 시 버튼 자체가 렌더되지 않음(선택 기능).
NEXT_PUBLIC_SUPPORT_URL=
